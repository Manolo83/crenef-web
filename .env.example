# Copia este archivo a .env para desarrollo local (nunca subas el .env real).

# Puerto local. En Railway, PORT lo define la plataforma sola.
PORT=3000
NODE_ENV=development

# --- Panel de administracion (/admin) -------------------------------------
# Contrasena para entrar al panel. Cambiala por una fuerte.
ADMIN_PASSWORD=cambia-esta-clave

# Alternativa mas segura: en vez de la contrasena en texto plano, su hash.
# Generalo con: node -e "console.log(require('bcryptjs').hashSync('tu-clave',10))"
# Si defines ADMIN_PASSWORD_HASH, tiene prioridad sobre ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=

# Clave para firmar la cookie de sesion del panel. Texto largo y aleatorio.
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esta-clave-tambien

# --- Datos -----------------------------------------------------------------
# Base de datos. En Railway: New > Database > PostgreSQL y la variable se crea
# sola. Si se deja vacia, el contenido se guarda en un archivo dentro de
# DATA_DIR (util en local, no recomendado en produccion).
DATABASE_URL=

# Carpeta de archivos subidos desde /admin. En Railway apuntala al Volume: /data
DATA_DIR=./data

# URL publica del sitio, sin diagonal al final.
SITE_URL=https://www.crenef.mx

# --- Aviso por correo de las solicitudes de cita (opcional) ----------------
# Sin estas variables las solicitudes igual se guardan y se ven en /admin;
# solo no llega el correo de aviso. Consigue la clave en resend.com.
RESEND_API_KEY=
RESEND_FROM=CRENEF <onboarding@resend.dev>
# A quien se le avisa (uno o varios correos separados por coma).
AVISOS_EMAIL=

# --- Medicion (opcional) ---------------------------------------------------
# Sin estas variables el sitio no carga NADA de terceros.
# Google Analytics 4
GA_ID=
# Google Ads: la cuenta de CRENEF es 905-783-5688 (dentro del MCC 894-945-9356)
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_CONTACTO=
# Meta Pixel
META_PIXEL_ID=

# --- Aviso automatico por WhatsApp (opcional) ------------------------------
# Respaldo para enterarse de una solicitud aunque el paciente nunca pulse
# "enviar" en su chat. Usa la API oficial de WhatsApp Cloud (Meta). Requiere un
# numero DISTINTO al que se usa en la app normal de WhatsApp. Paso a paso en el
# README, seccion "Aviso automatico por WhatsApp". Sin estas variables no pasa
# nada: el flujo normal sigue igual.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# A que numero(s) llega el aviso (10 digitos con lada, separados por coma).
WHATSAPP_AVISOS=
# Nombre de la plantilla aprobada en Meta, con 4 variables:
# {{1}} nombre, {{2}} telefono, {{3}} servicio, {{4}} motivo.
WHATSAPP_PLANTILLA=
WHATSAPP_IDIOMA=es_MX
